# Copy this file to .env and adjust values for the installation.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=merrylay_new_installation
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Required by Docker Compose for the MySQL root account.
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Use a root-relative path or an absolute HTTP(S) URL, including any subpath.
APP_BASE_URL=/merrylay_system
APP_ENV=production

# Relative paths are resolved from the application directory.
LOG_PATH=logs/php_errors.log
CACHE_PATH=cache

REDIS_HOST=localhost
REDIS_PORT=6379
